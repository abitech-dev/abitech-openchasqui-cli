{
  "info": {
    "name": "Petstore",
    "description": "Fixture that covers the cases the loader must handle.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "pets",
      "item": [
        {
          "name": "List pets",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pets"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20",
                  "disabled": true
                },
                {
                  "key": "species",
                  "value": "dog",
                  "disabled": true
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200]);",
                  "});",
                  "pm.test(\"content type is application/json\", function () {",
                  "  pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\");",
                  "});",
                  "pm.test(\"responds in under 5000 ms\", function () {",
                  "  pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "pm.test(\"matches the contract\", function () {",
                  "  pm.response.to.have.jsonSchema({\"type\":\"array\"});",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a pet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "disabled": false
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pets"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fido\",\n  \"species\": \"dog\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "showPet",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Trace",
                "value": "string",
                "disabled": false
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pets/:petId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pets",
                ":petId"
              ],
              "variable": [
                {
                  "key": "petId",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Delete a pet",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Trace",
                "value": "string",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pets/:petId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pets",
                ":petId"
              ],
              "variable": [
                {
                  "key": "petId",
                  "value": "1"
                }
              ]
            },
            "description": "Deprecated."
          }
        },
        {
          "name": "Upload a photo",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pets/:petId/photo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pets",
                ":petId",
                "photo"
              ],
              "variable": [
                {
                  "key": "petId",
                  "value": "1"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "store",
      "item": [
        {
          "name": "Opening hours",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/store/hours",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "store",
                "hours"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.example.com/v1"
    }
  ]
}
