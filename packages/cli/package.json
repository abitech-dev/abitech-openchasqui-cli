{
  "name": "@abitechdev/openchasqui",
  "version": "0.1.2",
  "description": "Genera, valida y distribuye colecciones de API (Postman, Bruno y más) desde OpenAPI.",
  "keywords": [
    "openapi",
    "postman",
    "bruno",
    "api-testing",
    "contract-testing",
    "openapi-overlay",
    "cli",
    "peru",
    "openchasqui"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "openchasqui": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abitech-dev/abitech-openchasqui-cli.git",
    "directory": "packages/cli"
  },
  "dependencies": {
    "@abitechdev/openchasqui-data-es-pe": "workspace:^",
    "@abitechdev/openchasqui-plugin-kit": "workspace:^",
    "json-p3": "3.0.3",
    "yaml": "2.9.1"
  },
  "scripts": {
    "prepack": "node ../../scripts/readme-npm.mjs"
  }
}
