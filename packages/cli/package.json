{
  "name": "@abitech/openchasqui",
  "version": "0.1.0",
  "description": "Generate, validate and distribute API collections from OpenAPI.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "openchasqui": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abitech-dev/abitech-openchasqui-cli.git",
    "directory": "packages/cli"
  },
  "dependencies": {
    "@abitech/openchasqui-core": "workspace:^",
    "@abitech/openchasqui-emitter-postman": "workspace:^",
    "@abitech/openchasqui-loader-openapi": "workspace:^",
    "@abitech/openchasqui-spec": "workspace:^"
  }
}
